#!/bin/sh /etc/rc.common
# procd-сервис мониторинга задержек вылетов Стригино.

USE_PROCD=1
START=95
STOP=10

PROG="/usr/bin/python3"
APP_DIR="/usr/lib/strigino-races"
CONF="/etc/strigino-races/config.json"

start_service() {
    procd_open_instance strigino-races
    procd_set_param command "$PROG" -m strigino --config "$CONF" run
    procd_set_param env PYTHONPATH="$APP_DIR" PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
    # respawn: не чаще 5 раз за час, пауза 15 с — сеть на роутере
    # может подниматься позже сервисов.
    procd_set_param respawn 3600 15 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param pidfile /var/run/strigino-races.pid
    procd_close_instance
}

reload_service() {
    restart
}

service_triggers() {
    procd_add_reload_trigger "network"
}

status_service() {
    PYTHONPATH="$APP_DIR" "$PROG" -m strigino --config "$CONF" status
}
